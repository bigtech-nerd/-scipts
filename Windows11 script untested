@echo off

color 0A
title CyberPatriot Windows 11 Security Script

REM Check for administrator privileges
net session >nul 2>&1
if %errorLevel% neq 0 (
    echo ERROR: This script must be run as Administrator!
    echo Right-click the script and select "Run as administrator"
    pause
    exit /b 1
)

echo ============================================================
echo   CyberPatriot Windows 11 Security Hardening Script
echo ============================================================
echo.
echo WARNING: This script will make significant security changes
echo Make sure you have read the README and noted:
echo   - Authorized users
echo   - Authorized administrators
echo   - Critical services
echo.
pause

:MENU
cls
echo ============================================================
echo                    MAIN MENU
echo ============================================================
echo.
echo [1] Enable Firewall
echo [2] Manage Services
echo [3] Configure Remote Desktop
echo [4] Apply Registry Security Settings
echo [5] Import Local Group Policies
echo [6] Disable Guest and Administrator Accounts
echo [7] User Audit (Authorized Users)
echo [8] Admin Audit (Authorized Admins)
echo [9] Reset User Passwords
echo [10] Remove Disallowed Media Files
echo [11] Configure Password Policies
echo [12] Configure Account Lockout Policies
echo [13] Configure Security Options
echo [14] Update Applications
echo [15] Remove Unauthorized Software
echo [16] Configure Remote Desktop Users
echo [17] Enable RDP Network Level Authentication
echo [18] Quick Security Scan
echo [19] Run ALL Security Fixes (Automated)
echo [0] Exit
echo.
set /p choice="Enter your choice: "

if "%choice%"=="1" goto FIREWALL
if "%choice%"=="2" goto SERVICES
if "%choice%"=="3" goto REMOTE_DESKTOP
if "%choice%"=="4" goto REGISTRY
if "%choice%"=="5" goto POLICIES
if "%choice%"=="6" goto GUEST_ADMIN
if "%choice%"=="7" goto USER_AUDIT
if "%choice%"=="8" goto ADMIN_AUDIT
if "%choice%"=="9" goto USER_PASSWORDS
if "%choice%"=="10" goto MEDIA_FILES
if "%choice%"=="11" goto PASSWORD_POLICY
if "%choice%"=="12" goto LOCKOUT_POLICY
if "%choice%"=="13" goto SECURITY_OPTIONS
if "%choice%"=="14" goto UPDATE_APPS
if "%choice%"=="15" goto REMOVE_SOFTWARE
if "%choice%"=="16" goto RDP_USERS
if "%choice%"=="17" goto RDP_NLA
if "%choice%"=="18" goto QUICK_SCAN
if "%choice%"=="19" goto RUN_ALL
if "%choice%"=="0" goto EXIT
goto MENU

:FIREWALL
cls
echo ============================================================
echo                  ENABLE FIREWALL
echo ============================================================
echo.
echo Enabling Windows Firewall for all profiles...
echo.

netsh advfirewall set allprofiles state on
if %errorLevel% equ 0 (
    echo [SUCCESS] Firewall enabled for all network profiles
) else (
    echo [ERROR] Failed to enable firewall
)

echo.
echo Press any key to return to menu...
pause >nul
goto MENU

:SERVICES
cls
echo ============================================================
echo                  MANAGE SERVICES
echo ============================================================
echo.
echo [M] Manual Mode - Review each service
echo [A] Automatic Mode - Disable all listed services
echo [C] Cancel
echo.
set /p servicemode="Select mode: "

if /i "%servicemode%"=="C" goto MENU
if /i "%servicemode%"=="M" goto SERVICES_MANUAL
if /i "%servicemode%"=="A" goto SERVICES_AUTO
goto SERVICES

:SERVICES_MANUAL
cls
echo ============================================================
echo              SERVICES - MANUAL MODE
echo ============================================================
echo.
echo WARNING: Be careful not to disable critical services!
echo Check the README for business-critical services.
echo.

REM List of potentially dangerous services
set services[0]=RemoteRegistry
set services[1]=RemoteAccess
set services[2]=Telnet
set services[3]=TlntSvr
set services[4]=SSDPSRV
set services[5]=upnphost
set services[6]=WMPNetworkSvc
set services[7]=icssvc
set services[8]=SharedAccess
set services[9]=Fax
set services[10]=FTPSVC
set services[11]=SNMP
set services[12]=SNMPTRAP
set services[13]=RpcSs

for /L %%i in (0,1,13) do (
    call :DISABLE_SERVICE_PROMPT "!services[%%i]!"
)

echo.
echo Service management complete!
pause
goto MENU

:DISABLE_SERVICE_PROMPT
set servicename=%~1
sc query %servicename% >nul 2>&1
if %errorLevel% neq 0 (
    echo [SKIP] Service %servicename% not found
    exit /b
)

echo.
echo Service: %servicename%
set /p disableservice="Disable this service? (y/n/c): "
if /i "%disableservice%"=="y" (
    sc config %servicename% start=disabled
    sc stop %servicename% >nul 2>&1
    echo [DISABLED] %servicename%
) else if /i "%disableservice%"=="c" (
    exit /b 1
) else (
    echo [SKIPPED] %servicename%
)
exit /b

:SERVICES_AUTO
cls
echo ============================================================
echo            SERVICES - AUTOMATIC MODE
echo ============================================================
echo.
echo WARNING: This will disable multiple services automatically!
echo This may break critical functionality!
echo.
set /p confirm="Are you SURE you want to continue? (yes/no): "
if /i not "%confirm%"=="yes" goto MENU

echo.
echo Disabling potentially dangerous services...

sc config RemoteRegistry start=disabled & sc stop RemoteRegistry
sc config RemoteAccess start=disabled & sc stop RemoteAccess
sc config Telnet start=disabled & sc stop Telnet
sc config TlntSvr start=disabled & sc stop TlntSvr
sc config SSDPSRV start=disabled & sc stop SSDPSRV
sc config upnphost start=disabled & sc stop upnphost
sc config WMPNetworkSvc start=disabled & sc stop WMPNetworkSvc
sc config icssvc start=disabled & sc stop icssvc
sc config SharedAccess start=disabled & sc stop SharedAccess
sc config Fax start=disabled & sc stop Fax
sc config FTPSVC start=disabled & sc stop FTPSVC
echo [DISABLED] FTPSVC - FTP service has been stopped and disabled
sc config SNMP start=disabled & sc stop SNMP
sc config SNMPTRAP start=disabled & sc stop SNMPTRAP

echo.
echo [COMPLETE] Services disabled
pause
goto MENU

:REMOTE_DESKTOP
cls
echo ============================================================
echo              CONFIGURE REMOTE DESKTOP
echo ============================================================
echo.
echo WARNING: Check README - Remote Desktop may be CRITICAL!
echo.
set /p rdp="Disable Remote Desktop? (y/n): "

if /i "%rdp%"=="y" (
    echo Disabling Remote Desktop...
    reg add "HKLM\SYSTEM\CurrentControlSet\Control\Terminal Server" /v fDenyTSConnections /t REG_DWORD /d 1 /f
    netsh advfirewall firewall set rule group="remote desktop" new enable=No
    echo [SUCCESS] Remote Desktop disabled
) else (
    echo [SKIPPED] Remote Desktop not modified
)

echo.
echo Disabling Remote Assistance connections...
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Terminal Server" /v fAllowToGetHelp /t REG_DWORD /d 0 /f
echo [SUCCESS] Remote Assistance disabled

echo.
pause
goto MENU

:RDP_NLA
cls
echo ============================================================
echo    ENABLE RDP NETWORK LEVEL AUTHENTICATION
echo ============================================================
echo.
echo This enables Network Level Authentication for Remote Desktop
echo for enhanced security requiring authentication before connection.
echo.
set /p enablenla="Enable RDP Network Level Authentication? (y/n): "

if /i not "%enablenla%"=="y" goto MENU

echo.
echo Enabling Network Level Authentication...
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp" /v SecurityLayer /t REG_DWORD /d 2 /f
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp" /v UserAuthentication /t REG_DWORD /d 1 /f

if %errorLevel% equ 0 (
    echo [SUCCESS] RDP Network Level Authentication enabled
) else (
    echo [ERROR] Failed to enable RDP Network Level Authentication
)

echo.
pause
goto MENU

:RDP_USERS
cls
echo ============================================================
echo           CONFIGURE REMOTE DESKTOP USERS
echo ============================================================
echo.
echo This adds authorized users to the Remote Desktop Users group.
echo.

if not exist "rdpusers.txt" (
    echo [ERROR] rdpusers.txt not found!
    echo Please create this file with one username per line.
    echo.
    pause
    goto MENU
)

echo Reading authorized RDP users from rdpusers.txt...
echo.
type rdpusers.txt
echo.
set /p proceed="Add these users to Remote Desktop Users group? (y/n): "

if /i not "%proceed%"=="y" goto MENU

echo.
echo Adding users to Remote Desktop Users group...

for /f "delims=" %%A in (rdpusers.txt) do (
    net localgroup "Remote Desktop Users" "%%A" /add >nul 2>&1
    if %errorLevel% equ 0 (
        echo [SUCCESS] Added %%A to Remote Desktop Users
    ) else (
        echo [INFO] %%A already in group or error occurred
    )
)

echo.
echo [SUCCESS] Remote Desktop Users group updated
pause
goto MENU

:REGISTRY
cls
echo ============================================================
echo           APPLY REGISTRY SECURITY SETTINGS
echo ============================================================
echo.
echo This will apply multiple security registry settings.
echo.
set /p applyreg="Apply registry security settings? (y/n): "

if /i not "%applyreg%"=="y" goto MENU

echo.
echo Applying registry security settings...

REM Disable AutoRun
reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer" /v NoDriveTypeAutoRun /t REG_DWORD /d 255 /f

REM Require Ctrl+Alt+Del
reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" /v DisableCAD /t REG_DWORD /d 0 /f

REM Enable UAC
reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" /v EnableLUA /t REG_DWORD /d 1 /f

REM Disable anonymous SID enumeration
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Lsa" /v RestrictAnonymousSAM /t REG_DWORD /d 1 /f
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Lsa" /v RestrictAnonymous /t REG_DWORD /d 1 /f

REM Disable LM hash storage
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Lsa" /v NoLMHash /t REG_DWORD /d 1 /f

REM Limit blank passwords to console only
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Lsa" /v LimitBlankPasswordUse /t REG_DWORD /d 1 /f
echo [SUCCESS] Blank passwords limited to console only

REM Enable Windows Defender
reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender" /v DisableAntiSpyware /t REG_DWORD /d 0 /f

echo.
echo [SUCCESS] Registry security settings applied
pause
goto MENU

:POLICIES
cls
echo ============================================================
echo           IMPORT LOCAL GROUP POLICIES
echo ============================================================
echo.
echo NOTE: This requires policy files in .\Policies\ directory
echo.
set /p importpol="Import policies? (y/n): "

if /i not "%importpol%"=="y" goto MENU

if not exist "Policies\" (
    echo [ERROR] Policies directory not found!
    pause
    goto MENU
)

echo Importing Local Group Policy Objects...
REM Add your policy import commands here
echo [INFO] Policy import functionality - add specific commands
pause
goto MENU

:GUEST_ADMIN
cls
echo ============================================================
echo        DISABLE GUEST AND ADMINISTRATOR ACCOUNTS
echo ============================================================
echo.

echo Disabling Guest account...
net user Guest /active:no
if %errorLevel% equ 0 (
    echo [SUCCESS] Guest account disabled
) else (
    echo [ERROR] Failed to disable Guest account
)

echo.
echo Disabling Administrator account...
net user Administrator /active:no
if %errorLevel% equ 0 (
    echo [SUCCESS] Administrator account disabled
) else (
    echo [ERROR] Failed to disable Administrator account
)

echo.
pause
goto MENU

:USER_AUDIT
cls
echo ============================================================
echo              USER AUDIT - AUTHORIZED USERS
echo ============================================================
echo.

if not exist "authorizedusers.txt" (
    echo [ERROR] authorizedusers.txt not found!
    echo Please create this file with one username per line.
    pause
    goto MENU
)

echo Reading authorized users from authorizedusers.txt...
echo.
echo Current users on system:
wmic useraccount get name
echo.
echo Authorized users from file:
type authorizedusers.txt
echo.
set /p proceed="Proceed with user audit? (y/n): "

if /i not "%proceed%"=="y" goto MENU

echo.
echo [INFO] User audit requires manual review
echo Use Computer Management (lusrmgr.msc) to:
echo   1. Delete unauthorized users
echo   2. Add missing authorized users
echo.
echo Opening Computer Management...
lusrmgr.msc

pause
goto MENU

:ADMIN_AUDIT
cls
echo ============================================================
echo            ADMIN AUDIT - AUTHORIZED ADMINS
echo ============================================================
echo.

if not exist "admins.txt" (
    echo [ERROR] admins.txt not found!
    echo Please create this file with one username per line.
    pause
    goto MENU
)

echo Reading authorized admins from admins.txt...
echo.
echo Current administrators:
net localgroup Administrators
echo.
echo Authorized administrators from file:
type admins.txt
echo.
set /p proceed="Proceed with admin audit? (y/n): "

if /i not "%proceed%"=="y" goto MENU

echo.
echo [INFO] Admin audit requires manual review
echo Use Computer Management (lusrmgr.msc) to:
echo   1. Remove unauthorized users from Administrators group
echo   2. Add missing authorized admins
echo.
echo Opening Computer Management...
lusrmgr.msc

pause
goto MENU

:USER_PASSWORDS
cls
echo ============================================================
echo               RESET USER PASSWORDS
echo ============================================================
echo.
echo This will reset ALL user passwords (except current user)
echo Default password: q1W@e3R$t5Y^u7I*o9
echo.
set /p resetpass="Reset passwords? (y/n): "

if /i not "%resetpass%"=="y" goto MENU

echo.
echo Resetting user passwords...
echo [INFO] This operation requires manual execution for each user
echo Use: net user [username] q1W@e3R$t5Y^u7I*o9
echo.
echo Opening Computer Management for manual password reset...
lusrmgr.msc

pause
goto MENU

:PASSWORD_POLICY
cls
echo ============================================================
echo           CONFIGURE PASSWORD POLICIES
echo ============================================================
echo.
echo Setting secure password requirements...
echo.
set /p applypwdpol="Apply password policies? (y/n): "

if /i not "%applypwdpol%"=="y" goto MENU

echo.
echo Applying password policies via net accounts...

REM Set minimum password age to 1 day
net accounts /minpwage:1
echo [SUCCESS] Minimum password age set to 1 day

REM Set password history to 24
net accounts /uniquepw:24
echo [SUCCESS] Password history set to 24 passwords remembered

REM Set maximum password age to 42 days
net accounts /maxpwage:42
echo [SUCCESS] Maximum password age set to 42 days

REM Set minimum password length to 8
net accounts /minpwlen:8
echo [SUCCESS] Minimum password length set to 8 characters

echo.
echo [SUCCESS] Secure password policies applied
pause
goto MENU

:LOCKOUT_POLICY
cls
echo ============================================================
echo         CONFIGURE ACCOUNT LOCKOUT POLICIES
echo ============================================================
echo.
echo Setting secure account lockout parameters...
echo.
set /p applylockout="Apply lockout policies? (y/n): "

if /i not "%applylockout%"=="y" goto MENU

echo.
echo Applying account lockout policies...

REM Set account lockout threshold to 5 invalid attempts
net accounts /lockoutthreshold:5
echo [SUCCESS] Account lockout threshold set to 5 attempts

REM Set lockout duration to 30 minutes
net accounts /lockoutduration:30
echo [SUCCESS] Account lockout duration set to 30 minutes

REM Set lockout counter reset to 30 minutes
net accounts /lockoutwindow:30
echo [SUCCESS] Lockout counter reset window set to 30 minutes

echo.
echo [SUCCESS] Secure account lockout policies applied
pause
goto MENU

:SECURITY_OPTIONS
cls
echo ============================================================
echo              CONFIGURE SECURITY OPTIONS
echo ============================================================
echo.
echo Applying additional security options...
echo.

echo Configuring registry security options...

REM Do not allow anonymous enumeration of SAM accounts
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Lsa" /v RestrictAnonymousSAM /t REG_DWORD /d 1 /f
echo [SUCCESS] Anonymous enumeration of SAM accounts disabled

REM Do not allow anonymous enumeration of shares
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Lsa" /v RestrictAnonymous /t REG_DWORD /d 1 /f
echo [SUCCESS] Anonymous enumeration disabled

REM Require Ctrl+Alt+Del for logon
reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" /v DisableCAD /t REG_DWORD /d 0 /f
echo [SUCCESS] Ctrl+Alt+Del requirement enabled

REM Enable SMBV1 disabled (network security)
reg add "HKLM\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters" /v SMB1 /t REG_DWORD /d 0 /f
echo [SUCCESS] SMBv1 disabled for enhanced network security

echo.
echo [SUCCESS] Security options configured
pause
goto MENU

:UPDATE_APPS
cls
echo ============================================================
echo              UPDATE APPLICATIONS
echo ============================================================
echo.
echo This will update critical applications:
echo   - Windows Updates
echo   - Notepad++
echo.
set /p updateapps="Proceed with application updates? (y/n): "

if /i not "%updateapps%"=="y" goto MENU

echo.
echo Checking for Windows Updates...
echo [INFO] Launching Windows Update settings...
start ms-settings:windowsupdate
echo [SUCCESS] Opening Windows Update - please install available updates

echo.
echo Notepad++ update check:
echo [INFO] Please manually update Notepad++ to latest version
echo Visit: https://notepad-plus-plus.org/downloads/

echo.
pause
goto MENU

:REMOVE_SOFTWARE
cls
echo ============================================================
echo           REMOVE UNAUTHORIZED SOFTWARE
echo ============================================================
echo.
echo This will remove known unauthorized applications:
echo   - Wireshark
echo   - CCleaner
echo.
set /p removesw="Remove unauthorized software? (y/n): "

if /i not "%removesw%"=="y" goto MENU

echo.
echo Searching for and removing unauthorized software...

REM Remove Wireshark
echo Removing Wireshark...
wmic product where name="Wireshark" call uninstall /nointeractive >nul 2>&1
if %errorLevel% equ 0 (
    echo [SUCCESS] Wireshark removed
) else (
    echo [INFO] Wireshark not found or already removed
)

REM Remove CCleaner
echo Removing CCleaner...
wmic product where name="CCleaner" call uninstall /nointeractive >nul 2>&1
if %errorLevel% equ 0 (
    echo [SUCCESS] CCleaner removed
) else (
    echo [INFO] CCleaner not found or already removed
)

echo.
echo [COMPLETE] Unauthorized software removal complete
pause
goto MENU

:QUICK_SCAN
cls
echo ============================================================
echo              QUICK SECURITY SCAN
echo ============================================================
echo.
echo Performing quick security checks...
echo.

echo Firewall Status:
netsh advfirewall show allprofiles | find "State"

echo.
echo Windows Defender Status:
sc query WinDefend | find "STATE"

echo.
echo FTPSVC Status:
sc query FTPSVC | find "STATE"

echo.
echo Remote Desktop Status:
reg query "HKLM\SYSTEM\CurrentControlSet\Control\Terminal Server" /v fDenyTSConnections

echo.
echo Windows Updates:
echo [INFO] Check Settings ^> Update ^& Security for details

echo.
pause
goto MENU

:RUN_ALL
cls
echo ============================================================
echo        RUN ALL SECURITY FIXES (AUTOMATED)
echo ============================================================
echo.
echo WARNING: This will automatically apply ALL security fixes!
echo This is a fully automated process with NO prompts!
echo.
set /p confirmall="Are you ABSOLUTELY SURE? (yes/no): "

if /i not "%confirmall%"=="yes" goto MENU

echo.
echo Running all security fixes...
echo.

echo [1/14] Enabling Firewall...
netsh advfirewall set allprofiles state on >nul 2>&1
echo [SUCCESS]

echo [2/14] Disabling FTPSVC...
sc config FTPSVC start=disabled >nul 2>&1
sc stop FTPSVC >nul 2>&1
echo [SUCCESS]

echo [3/14] Disabling Remote Desktop...
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Terminal Server" /v fDenyTSConnections /t REG_DWORD /d 1 /f >nul 2>&1
echo [SUCCESS]

echo [4/14] Disabling Remote Assistance...
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Terminal Server" /v fAllowToGetHelp /t REG_DWORD /d 0 /f >nul 2>&1
echo [SUCCESS]

echo [5/14] Enabling RDP Network Level Authentication...
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp" /v SecurityLayer /t REG_DWORD /d 2 /f >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp" /v UserAuthentication /t REG_DWORD /d 1 /f >nul 2>&1
echo [SUCCESS]

echo [6/14] Configuring Password Policies...
net accounts /minpwage:1 >nul 2>&1
net accounts /maxpwage:42 >nul 2>&1
net accounts /minpwlen:8 >nul 2>&1
net accounts /uniquepw:24 >nul 2>&1
echo [SUCCESS]

echo [7/14] Configuring Account Lockout Policies...
net accounts /lockoutthreshold:5 >nul 2>&1
net accounts /lockoutduration:30 >nul 2>&1
net accounts /lockoutwindow:30 >nul 2>&1
echo [SUCCESS]

echo [8/14] Limiting blank passwords to console only...
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Lsa" /v LimitBlankPasswordUse /t REG_DWORD /d 1 /f >nul 2>&1
echo [SUCCESS]

echo [9/14] Disabling anonymous enumeration...
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Lsa" /v RestrictAnonymousSAM /t REG_DWORD /d 1 /f >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Lsa" /v RestrictAnonymous /t REG_DWORD /d 1 /f >nul 2>&1
echo [SUCCESS]

echo [10/14] Disabling LM hash storage...
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Lsa" /v NoLMHash /t REG_DWORD /d 1 /f >nul 2>&1
echo [SUCCESS]

echo [11/14] Enabling UAC...
reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" /v EnableLUA /t REG_DWORD /d 1 /f >nul 2>&1
echo [SUCCESS]

echo [12/14] Disabling Guest and Administrator accounts...
net user Guest /active:no >nul 2>&1
net user Administrator /active:no >nul 2>&1
echo [SUCCESS]

echo [13/14] Removing Wireshark...
wmic product where name="Wireshark" call uninstall /nointeractive >nul 2>&1
echo [SUCCESS]

echo [14/14] Removing CCleaner...
wmic product where name="CCleaner" call uninstall /nointeractive >nul 2>&1
echo [SUCCESS]

echo.
echo ============================================================
echo        ALL SECURITY FIXES HAVE BEEN APPLIED!
echo ============================================================
echo.
echo IMPORTANT REMAINING TASKS:
echo   - Update Windows via Settings ^> Update ^& Security
echo   - Update Notepad++ to latest version
echo   - Review authorized users/admins files
echo   - Configure Remote Desktop Users (if needed)
echo.
pause
goto MENU

:EXIT
echo.
echo Thank you for using CyberPatriot Security Script!
echo.
pause
exit /b 0
