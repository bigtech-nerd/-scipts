#Requires -RunAsAdministrator
<#
.SYNOPSIS
    Windows Server 2022/2019 Security Hardening Script
.DESCRIPTION
    Automatically fixes security issues based on CIS benchmarks
.PARAMETER AuditOnly
    Only check issues without fixing them
.EXAMPLE
    .\Harden-Server.ps1
    .\Harden-Server.ps1 -AuditOnly
#>

[CmdletBinding()]
param([switch]$AuditOnly)

$Config = @{
    MinPasswordLength = 14
    MinPasswordAge = 1
    MaxPasswordAge = 60
    LockoutThreshold = 5
    LockoutDuration = 30
    DisableServices = @('W3SVC','MSFTPSVC','FTPSVC','RemoteRegistry','RemoteAccess','SSDPSRV','upnphost','WMPNetworkSvc','SMTPSVC')
    Backdoors = @('*netcat.exe','nc.exe','nc64.exe','ncat.exe','*tightvnc.exe','*realvnc.exe','*ultravnc.exe','vnc.exe','winvnc.exe','vncviewer.exe','mimikatz.exe','*mimikatz*.exe','pwdump*.exe','fgdump.exe','gsecdump.exe','wce.exe','procdump.exe','procdump64.exe','tini.exe','tini.jar','cryptcat.exe','socat.exe','meterpreter.exe','*meterpreter*.exe','psexec.exe','psexec64.exe')
    UnwantedApps = @('*TicTacToe*','*Solitaire*','*Minesweeper*','*CCleaner*','*John*Ripper*','*Hashcat*','*Metasploit*','*Aircrack*','*Burp*Suite*','*SQLmap*')
    ProhibitedFiles = @('*password*.txt','*passwd*.txt','*pwd*.txt','*.mp3','*.mp4','*.avi','*.mkv','*crack*.exe','*keygen*.exe','*warez*.*','*brutus*.zip','*brutus*.rar','*brutus*.7z')
}

$Results = @()
$LogFile = "C:\SecurityHardening_$(Get-Date -Format 'yyyyMMdd_HHmmss').log"
$FixedCount = 0
$IssueCount = 0

function Write-Pass { Write-Host "[+] $args" -ForegroundColor Green }
function Write-Fail { Write-Host "[-] $args" -ForegroundColor Red; $script:IssueCount++ }
function Write-Fixed { Write-Host "[FIXED] $args" -ForegroundColor Cyan; $script:FixedCount++ }
function Write-Info { Write-Host "[*] $args" -ForegroundColor White }
function Write-Warn { Write-Host "[!] $args" -ForegroundColor Yellow }
function Write-Section { Write-Host "`n=== $args ===" -ForegroundColor Magenta }

function Add-Result($Category, $Check, $Status, $Details) {
    $script:Results += [PSCustomObject]@{
        Category = $Category
        Check = $Check
        Status = $Status
        Details = $Details
    }
}

function Get-RegValue($Path, $Name) {
    try { return Get-ItemPropertyValue -Path $Path -Name $Name -ErrorAction Stop }
    catch { return $null }
}

Start-Transcript -Path $LogFile
Write-Info "Windows Server Security Hardening Script"
Write-Info "Server: $env:COMPUTERNAME - $(Get-Date)"
if ($AuditOnly) { Write-Warn "AUDIT MODE: No changes will be made" }
else { Write-Info "HARDENING MODE: Fixing issues automatically" }

Write-Section "ACCOUNT POLICIES"
$secpol = "$env:TEMP\secpol.cfg"
secedit /export /cfg $secpol /quiet | Out-Null
$policy = Get-Content $secpol

function Get-PolicyValue($key) {
    $line = $policy | Where-Object { $_ -match "^$key\s*=" }
    if ($line) { return ($line -split '=')[1].Trim() }
    return $null
}

Write-Info "Checking password length..."
$minPwd = [int](Get-PolicyValue "MinimumPasswordLength")
if ($minPwd -lt $Config.MinPasswordLength) {
    Write-Fail "Password length too short: $minPwd chars (need $($Config.MinPasswordLength))"
    if (!$AuditOnly) {
        $policy = $policy -replace "MinimumPasswordLength = \d+", "MinimumPasswordLength = $($Config.MinPasswordLength)"
        Write-Fixed "Set minimum password length to $($Config.MinPasswordLength) characters"
    }
    Add-Result "Account" "Password Length" "FIXED" "$minPwd -> $($Config.MinPasswordLength)"
} else {
    Write-Pass "Password length OK: $minPwd chars"
    Add-Result "Account" "Password Length" "PASS" "$minPwd chars"
}

Write-Info "Checking password age policies..."
$minAge = [int](Get-PolicyValue "MinimumPasswordAge")
$maxAge = [int](Get-PolicyValue "MaximumPasswordAge")
if ($minAge -lt $Config.MinPasswordAge -or $maxAge -eq -1 -or $maxAge -gt $Config.MaxPasswordAge) {
    Write-Fail "Password age policy weak: Min=$minAge Max=$maxAge"
    if (!$AuditOnly) {
        $policy = $policy -replace "MinimumPasswordAge = -?\d+", "MinimumPasswordAge = $($Config.MinPasswordAge)"
        $policy = $policy -replace "MaximumPasswordAge = -?\d+", "MaximumPasswordAge = $($Config.MaxPasswordAge)"
        Write-Fixed "Set password age: Min=$($Config.MinPasswordAge) Max=$($Config.MaxPasswordAge) days"
    }
    Add-Result "Account" "Password Age" "FIXED" "Min=$($Config.MinPasswordAge)d Max=$($Config.MaxPasswordAge)d"
} else {
    Write-Pass "Password age OK: Min=$minAge Max=$maxAge days"
    Add-Result "Account" "Password Age" "PASS" "Compliant"
}

Write-Info "Checking password complexity..."
$complex = [int](Get-PolicyValue "PasswordComplexity")
if ($complex -eq 0) {
    Write-Fail "Password complexity disabled"
    if (!$AuditOnly) {
        $policy = $policy -replace "PasswordComplexity = \d+", "PasswordComplexity = 1"
        Write-Fixed "Enabled password complexity requirements"
    }
    Add-Result "Account" "Complexity" "FIXED" "Enabled"
} else {
    Write-Pass "Password complexity enabled"
    Add-Result "Account" "Complexity" "PASS" "Enabled"
}

Write-Info "Checking reversible encryption..."
$reversible = [int](Get-PolicyValue "ClearTextPassword")
if ($reversible -ne 0) {
    Write-Fail "Reversible encryption enabled (stores passwords in plaintext!)"
    if (!$AuditOnly) {
        $policy = $policy -replace "ClearTextPassword = \d+", "ClearTextPassword = 0"
        Write-Fixed "Disabled reversible encryption"
    }
    Add-Result "Account" "Reversible Encryption" "FIXED" "Disabled"
} else {
    Write-Pass "Reversible encryption disabled"
    Add-Result "Account" "Reversible Encryption" "PASS" "Disabled"
}

Write-Info "Checking account lockout..."
$lockout = [int](Get-PolicyValue "LockoutBadCount")
if ($lockout -eq 0 -or $lockout -gt $Config.LockoutThreshold) {
    Write-Fail "Lockout policy weak: $lockout attempts (need $($Config.LockoutThreshold))"
    if (!$AuditOnly) {
        $policy = $policy -replace "LockoutBadCount = \d+", "LockoutBadCount = $($Config.LockoutThreshold)"
        $policy = $policy -replace "LockoutDuration = \d+", "LockoutDuration = $($Config.LockoutDuration)"
        $policy = $policy -replace "ResetLockoutCount = \d+", "ResetLockoutCount = $($Config.LockoutDuration)"
        Write-Fixed "Set lockout: $($Config.LockoutThreshold) attempts, $($Config.LockoutDuration) min duration"
    }
    Add-Result "Account" "Lockout" "FIXED" "$($Config.LockoutThreshold) attempts"
} else {
    Write-Pass "Account lockout OK: $lockout attempts"
    Add-Result "Account" "Lockout" "PASS" "$lockout attempts"
}

if (!$AuditOnly) {
    $policy | Set-Content $secpol
    secedit /configure /db "$env:TEMP\secedit.sdb" /cfg $secpol /quiet | Out-Null
}
Remove-Item $secpol -Force -ErrorAction SilentlyContinue

Write-Section "SECURITY OPTIONS"

Write-Info "Checking blank password policy..."
$blankPwd = Get-RegValue "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa" "LimitBlankPasswordUse"
if ($blankPwd -ne 1) {
    Write-Fail "Blank passwords not restricted to console only"
    if (!$AuditOnly) {
        Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa" -Name "LimitBlankPasswordUse" -Value 1 -Type DWord -Force
        Write-Fixed "Restricted blank passwords to console logon only"
    }
    Add-Result "Security" "Blank Passwords" "FIXED" "Console only"
} else {
    Write-Pass "Blank passwords restricted to console"
    Add-Result "Security" "Blank Passwords" "PASS" "Console only"
}

Write-Info "Checking anonymous SAM account enumeration..."
$anonSAM = Get-RegValue "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa" "RestrictAnonymousSAM"
if ($anonSAM -ne 1) {
    Write-Fail "Anonymous SAM enumeration allowed"
    if (!$AuditOnly) {
        Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa" -Name "RestrictAnonymousSAM" -Value 1 -Type DWord -Force
        Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa" -Name "RestrictAnonymous" -Value 1 -Type DWord -Force
        Write-Fixed "Disabled anonymous SAM enumeration"
    }
    Add-Result "Security" "Anonymous SAM" "FIXED" "Disabled"
} else {
    Write-Pass "Anonymous SAM enumeration disabled"
    Add-Result "Security" "Anonymous SAM" "PASS" "Disabled"
}

Write-Info "Checking anonymous enumeration of SAM accounts AND shares..."
$anonSAMShares = Get-RegValue "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa" "RestrictAnonymous"
$everyoneSetting = Get-RegValue "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa" "EveryoneIncludesAnonymous"
if ($anonSAMShares -ne 1 -or $everyoneSetting -ne 0) {
    Write-Fail "Anonymous enumeration of SAM accounts and shares not fully restricted"
    if (!$AuditOnly) {
        Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa" -Name "RestrictAnonymous" -Value 1 -Type DWord -Force
        Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa" -Name "EveryoneIncludesAnonymous" -Value 0 -Type DWord -Force
        if (!(Test-Path "HKLM:\SYSTEM\CurrentControlSet\Services\LanManServer\Parameters")) {
            New-Item -Path "HKLM:\SYSTEM\CurrentControlSet\Services\LanManServer\Parameters" -Force | Out-Null
        }
        Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Services\LanManServer\Parameters" -Name "RestrictNullSessAccess" -Value 1 -Type DWord -Force
        Write-Fixed "Disabled anonymous enumeration of SAM accounts and shares"
    }
    Add-Result "Security" "Anonymous SAM+Shares" "FIXED" "Fully restricted"
} else {
    Write-Pass "Anonymous enumeration of SAM accounts and shares disabled"
    Add-Result "Security" "Anonymous SAM+Shares" "PASS" "Fully restricted"
}

Write-Info "Checking Secure Attention Sequence (Ctrl+Alt+Del)..."
$disableCAD = Get-RegValue "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" "DisableCAD"
if ($disableCAD -ne 0) {
    Write-Fail "Ctrl+Alt+Del not required for logon"
    if (!$AuditOnly) {
        Set-ItemProperty -Path "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" -Name "DisableCAD" -Value 0 -Type DWord -Force
        Write-Fixed "Enabled Ctrl+Alt+Del requirement"
    }
    Add-Result "Security" "Ctrl+Alt+Del" "FIXED" "Required"
} else {
    Write-Pass "Ctrl+Alt+Del required for logon"
    Add-Result "Security" "Ctrl+Alt+Del" "PASS" "Required"
}

Write-Info "Checking LM authentication level..."
$lmLevel = Get-RegValue "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa" "LmCompatibilityLevel"
if ($null -eq $lmLevel -or $lmLevel -lt 5) {
    Write-Fail "LM authentication level too weak (allows old protocols)"
    if (!$AuditOnly) {
        Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa" -Name "LmCompatibilityLevel" -Value 5 -Type DWord -Force
        Write-Fixed "Set to NTLMv2 only (level 5)"
    }
    Add-Result "Security" "LM Auth" "FIXED" "NTLMv2 only"
} else {
    Write-Pass "LM authentication: NTLMv2 only"
    Add-Result "Security" "LM Auth" "PASS" "Level 5"
}

Write-Info "Checking Windows Script Host..."
$wsh = Get-RegValue "HKLM:\SOFTWARE\Microsoft\Windows Script Host\Settings" "Enabled"
if ($null -eq $wsh -or $wsh -ne 0) {
    Write-Fail "Windows Script Host enabled (allows .vbs/.js malware)"
    if (!$AuditOnly) {
        if (!(Test-Path "HKLM:\SOFTWARE\Microsoft\Windows Script Host\Settings")) {
            New-Item -Path "HKLM:\SOFTWARE\Microsoft\Windows Script Host\Settings" -Force | Out-Null
        }
        Set-ItemProperty -Path "HKLM:\SOFTWARE\Microsoft\Windows Script Host\Settings" -Name "Enabled" -Value 0 -Type DWord -Force
        Write-Fixed "Disabled Windows Script Host"
    }
    Add-Result "Security" "WSH" "FIXED" "Disabled"
} else {
    Write-Pass "Windows Script Host disabled"
    Add-Result "Security" "WSH" "PASS" "Disabled"
}

Write-Info "Checking AutoRun/AutoPlay..."
$autorun = Get-RegValue "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer" "NoDriveTypeAutoRun"
if ($autorun -ne 255) {
    Write-Fail "AutoRun not fully disabled (USB malware risk)"
    if (!$AuditOnly) {
        if (!(Test-Path "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer")) {
            New-Item -Path "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer" -Force | Out-Null
        }
        Set-ItemProperty -Path "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer" -Name "NoDriveTypeAutoRun" -Value 255 -Type DWord -Force
        Write-Fixed "Disabled AutoRun for all drive types"
    }
    Add-Result "Security" "AutoRun" "FIXED" "Disabled"
} else {
    Write-Pass "AutoRun disabled for all drives"
    Add-Result "Security" "AutoRun" "PASS" "Disabled"
}

Write-Section "NETWORK SECURITY"

Write-Info "Checking SMB 1.x..."
$smb1 = Get-WindowsOptionalFeature -Online -FeatureName SMB1Protocol -ErrorAction SilentlyContinue
if ($smb1 -and $smb1.State -eq "Enabled") {
    Write-Fail "SMB 1.x enabled (CRITICAL VULNERABILITY)"
    if (!$AuditOnly) {
        Disable-WindowsOptionalFeature -Online -FeatureName SMB1Protocol -NoRestart | Out-Null
        Write-Fixed "Disabled SMB 1.x (reboot required to complete)"
    }
    Add-Result "Network" "SMB 1.x" "FIXED" "Disabled"
} else {
    Write-Pass "SMB 1.x disabled"
    Add-Result "Network" "SMB 1.x" "PASS" "Disabled"
}

Write-Info "Checking SMB signing..."
$smbSignSrv = Get-RegValue "HKLM:\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters" "RequireSecuritySignature"
$smbSignCli = Get-RegValue "HKLM:\SYSTEM\CurrentControlSet\Services\LanmanWorkstation\Parameters" "RequireSecuritySignature"
if ($smbSignSrv -ne 1 -or $smbSignCli -ne 1) {
    Write-Fail "SMB signing not enforced (man-in-the-middle risk)"
    if (!$AuditOnly) {
        Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters" -Name "RequireSecuritySignature" -Value 1 -Type DWord -Force
        Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters" -Name "EnableSecuritySignature" -Value 1 -Type DWord -Force
        Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Services\LanmanWorkstation\Parameters" -Name "RequireSecuritySignature" -Value 1 -Type DWord -Force
        Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Services\LanmanWorkstation\Parameters" -Name "EnableSecuritySignature" -Value 1 -Type DWord -Force
        Write-Fixed "Enforced SMB signing (always required)"
    }
    Add-Result "Network" "SMB Signing" "FIXED" "Always required"
} else {
    Write-Pass "SMB signing enforced"
    Add-Result "Network" "SMB Signing" "PASS" "Always required"
}

Write-Section "WINDOWS FIREWALL"

Write-Info "Checking firewall status..."
$fwProfiles = Get-NetFirewallProfile
$fwOff = $fwProfiles | Where-Object { $_.Enabled -eq $false }
if ($fwOff) {
    Write-Fail "Firewall disabled on: $($fwOff.Name -join ', ')"
    if (!$AuditOnly) {
        Set-NetFirewallProfile -All -Enabled True
        Write-Fixed "Enabled firewall on all profiles: Domain, Private, Public"
    }
    Add-Result "Firewall" "Status" "FIXED" "All profiles enabled"
} else {
    Write-Pass "Firewall enabled on all profiles"
    Add-Result "Firewall" "Status" "PASS" "All enabled"
}

Write-Section "AUDIT POLICIES (CIS Baseline)"

Write-Info "Configuring comprehensive audit policies..."
try {
    if (!(Test-Path "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa")) {
        New-Item -Path "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa" -Force | Out-Null
    }
    Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa" -Name "SCENoApplyLegacyAuditPolicy" -Value 1 -Type DWord -Force
} catch {}

$auditPolicies = @(
    'Credential Validation','Kerberos Authentication Service','Kerberos Service Ticket Operations',
    'Application Group Management','Computer Account Management','Distribution Group Management',
    'Other Account Management Events','Security Group Management','User Account Management',
    'PNP Activity','Process Creation','DPAPI Activity','RPC Events',
    'Directory Service Access','Directory Service Changes','Directory Service Replication',
    'Account Lockout','Group Membership','Logoff','Logon','Other Logon/Logoff Events','Special Logon',
    'IPsec Extended Mode','IPsec Main Mode','IPsec Quick Mode','Network Policy Server',
    'Application Generated','Certification Services','Detailed File Share','File Share','File System',
    'Filtering Platform Connection','Filtering Platform Packet Drop','Handle Manipulation',
    'Kernel Object','Other Object Access Events','Registry','Removable Storage','SAM',
    'Audit Policy Change','Authentication Policy Change','Authorization Policy Change',
    'Filtering Platform Policy Change','MPSSVC Rule-Level Policy Change','Other Policy Change Events',
    'Sensitive Privilege Use','IPsec Driver','Other System Events','Security State Change',
    'Security System Extension','System Integrity'
)

$configuredCount = 0
if (!$AuditOnly) {
    foreach ($subcategory in $auditPolicies) {
        try {
            auditpol /set /subcategory:"$subcategory" /success:enable /failure:enable 2>&1 | Out-Null
            $configuredCount++
        } catch {}
    }
    Write-Fixed "Configured $configuredCount audit policy subcategories (CIS baseline)"
}
Add-Result "Audit" "Advanced Policies" "FIXED" "$configuredCount subcategories configured"

Write-Section "SERVICE HARDENING"

Write-Info "Checking unnecessary services..."
$disabledCount = 0
foreach ($svc in $Config.DisableServices) {
    $service = Get-Service -Name $svc -ErrorAction SilentlyContinue
    if ($service -and $service.StartType -ne 'Disabled') {
        Write-Fail "Unnecessary service running: $svc"
        if (!$AuditOnly) {
            Stop-Service -Name $svc -Force -ErrorAction SilentlyContinue
            Set-Service -Name $svc -StartupType Disabled -ErrorAction SilentlyContinue
            $disabledCount++
            Write-Fixed "Disabled service: $svc"
        }
        Add-Result "Services" $svc "FIXED" "Disabled"
    } elseif ($service) {
        Add-Result "Services" $svc "PASS" "Already disabled"
    }
}
if ($disabledCount -gt 0) { Write-Info "Total services disabled: $disabledCount" }

Write-Section "FILE SHARES"

Write-Info "Checking administrative file shares..."
$cShare = Get-SmbShare -Name "C$" -ErrorAction SilentlyContinue
if ($cShare) {
    Write-Warn "Administrative share C$ is enabled"
    Add-Result "Shares" "C$ Admin Share" "INFO" "Enabled"
}

Write-Info "Checking for potentially risky file shares..."
$shares = Get-SmbShare | Where-Object { $_.Name -notlike '*$' -and $_.Name -ne 'IPC$' }
$riskyShares = @()
foreach ($share in $shares) {
    if ($share.Name -match 'greybeard|public|everyone|share|temp|common') {
        Write-Warn "FOUND RISKY SHARE: $($share.Name) at $($share.Path)"
        $riskyShares += "$($share.Name) (Path: $($share.Path))"
        $sharePerms = Get-SmbShareAccess -Name $share.Name -ErrorAction SilentlyContinue
        foreach ($perm in $sharePerms) {
            if ($perm.AccountName -eq 'Everyone' -or $perm.AccountName -eq 'Guest') {
                Write-Warn "  Share allows access to: $($perm.AccountName)"
            }
        }
    }
}
if ($riskyShares.Count -gt 0) {
    Write-Fail "Found $($riskyShares.Count) risky file shares - MANUAL REVIEW REQUIRED"
    Add-Result "Shares" "Risky Shares" "MANUAL" "$($riskyShares.Count) shares found"
} else {
    Write-Pass "No risky file shares detected"
    Add-Result "Shares" "Risky Shares" "PASS" "No risky shares"
}

Write-Section "REMOTE ACCESS"

Write-Info "Checking RDP Network Level Authentication..."
$nla = Get-RegValue "HKLM:\SYSTEM\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp" "UserAuthentication"
if ($nla -ne 1) {
    Write-Fail "RDP NLA not enabled"
    if (!$AuditOnly) {
        Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp" -Name "UserAuthentication" -Value 1 -Type DWord -Force
        Write-Fixed "Enabled RDP Network Level Authentication"
    }
    Add-Result "Remote" "RDP NLA" "FIXED" "Enabled"
} else {
    Write-Pass "RDP NLA enabled"
    Add-Result "Remote" "RDP NLA" "PASS" "Enabled"
}

Write-Info "Checking Remote Assistance..."
$ra = Get-RegValue "HKLM:\SYSTEM\CurrentControlSet\Control\Remote Assistance" "fAllowToGetHelp"
if ($ra -ne 0) {
    Write-Fail "Remote Assistance enabled"
    if (!$AuditOnly) {
        if (!(Test-Path "HKLM:\SYSTEM\CurrentControlSet\Control\Remote Assistance")) {
            New-Item -Path "HKLM:\SYSTEM\CurrentControlSet\Control\Remote Assistance" -Force | Out-Null
        }
        Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\Remote Assistance" -Name "fAllowToGetHelp" -Value 0 -Type DWord -Force
        Write-Fixed "Disabled Remote Assistance"
    }
    Add-Result "Remote" "Remote Assistance" "FIXED" "Disabled"
} else {
    Write-Pass "Remote Assistance disabled"
    Add-Result "Remote" "Remote Assistance" "PASS" "Disabled"
}

$rdp = Get-RegValue "HKLM:\SYSTEM\CurrentControlSet\Control\Terminal Server" "fDenyTSConnections"
if ($rdp -ne 1) {
    Write-Info "NOTE: Remote Desktop is enabled (not changing)"
    Add-Result "Remote" "RDP Status" "INFO" "Enabled"
}

Write-Section "WINDOWS UPDATE"

Write-Info "Configuring automatic Windows Updates..."
try {
    $au = (New-Object -ComObject "Microsoft.Update.AutoUpdate").Settings
    if ($au.NotificationLevel -ne 4) {
        Write-Fail "Automatic updates not configured"
        if (!$AuditOnly) {
            $au.NotificationLevel = 4
            $au.Save()
            Write-Fixed "Enabled automatic Windows Updates"
        }
        Add-Result "Updates" "Windows Update" "FIXED" "Automatic"
    } else {
        Write-Pass "Automatic Windows Updates enabled"
        Add-Result "Updates" "Windows Update" "PASS" "Automatic"
    }
} catch {
    Write-Warn "Could not configure Windows Update"
    Add-Result "Updates" "Windows Update" "MANUAL" "Check manually"
}

Write-Section "MALWARE SCAN"

Write-Info "Scanning for backdoors..."
$foundBackdoors = @()
$scanPaths = @("C:\Windows\Temp", "C:\Users", "C:\Temp")
foreach ($path in $scanPaths) {
    if (Test-Path $path) {
        foreach ($pattern in $Config.Backdoors) {
            $files = Get-ChildItem -Path $path -Filter $pattern -Recurse -ErrorAction SilentlyContinue -Force |
                     Where-Object { !$_.PSIsContainer } | Select-Object -First 5
            foreach ($file in $files) {
                if ($file.FullName -notmatch "System32|SysWOW64|WinSxS") {
                    $foundBackdoors += $file.FullName
                    Write-Warn "POTENTIAL BACKDOOR: $($file.FullName)"
                }
            }
        }
    }
}
if ($foundBackdoors.Count -gt 0) {
    Write-Fail "Found $($foundBackdoors.Count) potential backdoors - MANUAL REVIEW REQUIRED"
    Add-Result "Malware" "Backdoors" "MANUAL" "$($foundBackdoors.Count) files"
} else {
    Write-Pass "No known backdoors detected"
    Add-Result "Malware" "Backdoors" "PASS" "Clean"
}

Write-Section "PROHIBITED FILES SCAN"

Write-Info "Scanning for prohibited files..."
$foundFiles = @()
$searchPaths = @("C:\Users", "C:\Temp", "C:\Public")

$specificChecks = @(
    "C:\Users\Public\Public Downloads\brutus-aet2-darknet.zip",
    "C:\Users\Public\Downloads\brutus-aet2-darknet.zip",
    "C:\brutus-aet2-darknet.zip"
)

foreach ($checkPath in $specificChecks) {
    if (Test-Path $checkPath) {
        Write-Warn "FOUND HACKING TOOL: $checkPath"
        $foundFiles += $checkPath
    }
}

foreach ($path in $searchPaths) {
    if (Test-Path $path) {
        foreach ($pattern in $Config.ProhibitedFiles) {
            if ($pattern -eq "*password*.txt") {
                $files = Get-ChildItem -Path $path -Filter $pattern -Recurse -ErrorAction SilentlyContinue -Force |
                         Where-Object { !$_.PSIsContainer -and $_.DirectoryName -notmatch "AppData\\Local.*\\Cache" } |
                         Select-Object -First 5
            } else {
                $files = Get-ChildItem -Path $path -Filter $pattern -Recurse -ErrorAction SilentlyContinue -Force |
                         Where-Object { !$_.PSIsContainer } | Select-Object -First 5
            }
            foreach ($file in $files) {
                $foundFiles += $file.FullName
                Write-Warn "PROHIBITED FILE: $($file.FullName)"
            }
        }
    }
}

if ($foundFiles.Count -gt 0) {
    Write-Fail "Found $($foundFiles.Count) prohibited files - MANUAL REMOVAL REQUIRED"
    Add-Result "Files" "Prohibited Content" "MANUAL" "$($foundFiles.Count) files"
} else {
    Write-Pass "No prohibited files found"
    Add-Result "Files" "Prohibited Content" "PASS" "Clean"
}

Write-Section "SUMMARY"
Write-Host ""
if (!$AuditOnly) { Write-Host "FIXES APPLIED: $FixedCount" -ForegroundColor Green }
Write-Host "ISSUES FOUND: $IssueCount" -ForegroundColor $(if ($IssueCount -eq 0) { "Green" } else { "Red" })

$summary = $Results | Group-Object Status | Select-Object Name, Count
$summary | ForEach-Object {
    $color = switch ($_.Name) {
        "PASS" { "Green" }
        "FIXED" { "Cyan" }
        "FAIL" { "Red" }
        "MANUAL" { "Yellow" }
        "INFO" { "Gray" }
        default { "White" }
    }
    Write-Host "  $($_.Name): $($_.Count)" -ForegroundColor $color
}

$csvFile = $LogFile -replace "\.log$", ".csv"
$Results | Export-Csv -Path $csvFile -NoTypeInformation
Write-Host "`nDetailed results: $csvFile" -ForegroundColor Gray

$manualItems = $Results | Where-Object { $_.Status -eq "MANUAL" }
if ($manualItems) {
    Write-Section "MANUAL ACTIONS REQUIRED"
    Write-Host "The following items need your attention:`n" -ForegroundColor Yellow
    foreach ($item in $manualItems) {
        Write-Host "[$($item.Category)] $($item.Check)" -ForegroundColor Yellow
        Write-Host "  Details: $($item.Details)" -ForegroundColor White
        if ($item.Category -eq "Shares") {
            Write-Host "  Command: Remove-SmbShare -Name 'ShareName' -Force" -ForegroundColor Cyan
        } elseif ($item.Category -eq "Files" -or $item.Category -eq "Malware") {
            Write-Host "  Command: Remove-Item 'C:\Path\To\File' -Force" -ForegroundColor Cyan
        }
        Write-Host ""
    }
}

if (!$AuditOnly -and $FixedCount -gt 0) {
    Write-Host "`n!!! REBOOT REQUIRED !!!" -ForegroundColor Black -BackgroundColor Yellow
    Write-Host "Some changes require a reboot (especially SMB 1.x removal)" -ForegroundColor Yellow
    $reboot = Read-Host "`nReboot now? (Y/N)"
    if ($reboot -eq 'Y' -or $reboot -eq 'y') {
        Write-Info "Rebooting in 60 seconds..."
        shutdown /r /t 60 /c "Security hardening complete"
    }
}

Stop-Transcript
Write-Host "`nLog saved to: $LogFile" -ForegroundColor Gray
