#!/bin/bash
# Linux Mint Security Hardening Script
# Updated for modern CIS standards

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

startTime=$(date +"%s")
LOGFILE="$HOME/Desktop/Security_Script_$(date +%Y%m%d_%H%M%S).log"

printTime() {
    endTime=$(date +"%s")
    diffTime=$((endTime - startTime))
    timestamp=$(printf "%02d:%02d" $((diffTime / 60)) $((diffTime % 60)))
    echo -e "${timestamp} -- $1" | tee -a "$LOGFILE"
}

# Check if running as root
if [[ $EUID -ne 0 ]]; then
    echo -e "${RED}This script must be run as root${NC}"
    exit 1
fi

printTime "Script started as root."

# Create backup and log directories
mkdir -p "$HOME/Desktop/backups"
mkdir -p "$HOME/Desktop/logs"
chmod 700 "$HOME/Desktop/backups"
chmod 700 "$HOME/Desktop/logs"
printTime "Backup and log directories created."

# Backup critical files
backup_file() {
    if [[ -f "$1" ]]; then
        cp "$1" "$HOME/Desktop/backups/$(basename $1).backup" 2>/dev/null
        printTime "Backed up: $1"
    fi
}

backup_file "/etc/passwd"
backup_file "/etc/group"
backup_file "/etc/shadow"
backup_file "/etc/login.defs"
backup_file "/etc/ssh/sshd_config"

# User Management
echo -e "${YELLOW}User Management Section${NC}"
echo "Enter usernames to manage (space-separated), or press Enter to skip:"
read -a users

for user in "${users[@]}"; do
    if ! id "$user" &>/dev/null; then
        echo "User $user does not exist. Skip."
        continue
    fi
    
    echo -e "\n${GREEN}Managing user: $user${NC}"
    echo "Delete $user? (yes/no)"
    read yn1
    
    if [[ "$yn1" == "yes" ]]; then
        userdel -r "$user" 2>/dev/null
        printTime "User $user deleted."
    else
        echo "Make $user administrator? (yes/no)"
        read yn2
        
        if [[ "$yn2" == "yes" ]]; then
            usermod -aG sudo "$user"
            printTime "$user added to sudo group."
        else
            # Remove from admin groups
            for group in sudo adm lpadmin sambashare; do
                gpasswd -d "$user" "$group" 2>/dev/null
            done
            printTime "$user set as standard user."
        fi
        
        # Password policies (applied to existing users)
        chage -M 90 -m 7 -W 14 "$user"
        printTime "Password aging set for $user: max 90 days, min 7 days, warn 14 days."
    fi
done

# Add new users
echo -e "\n${YELLOW}Add new users? Enter usernames (space-separated), or press Enter to skip:${NC}"
read -a newUsers

for newUser in "${newUsers[@]}"; do
    if id "$newUser" &>/dev/null; then
        echo "User $newUser already exists. Skipping."
        continue
    fi
    
    adduser "$newUser"
    chage -M 90 -m 7 -W 14 "$newUser"
    printTime "User $newUser created with password policies."
    
    echo "Make $newUser administrator? (yes/no)"
    read ynAdmin
    if [[ "$ynAdmin" == "yes" ]]; then
        usermod -aG sudo "$newUser"
        printTime "$newUser added to sudo group."
    fi
done

# Service Configuration
echo -e "\n${YELLOW}Service Configuration${NC}"
read -p "Does this machine need SSH? (yes/no): " sshYN
read -p "Does this machine need Samba? (yes/no): " sambaYN
read -p "Will this machine be a Web Server (Apache)? (yes/no): " httpYN
read -p "Does this machine need MySQL? (yes/no): " dbYN
read -p "Does this machine need FTP? (yes/no): " ftpYN
read -p "Remove prohibited media files? (yes/no): " mediaFilesYN

# Lock root account
passwd -l root
printTime "Root account locked."

# Configure SSH
if [[ "$sshYN" == "yes" ]]; then
    backup_file "/etc/ssh/sshd_config"
    
    # CIS SSH hardening
    sed -i 's/^#*PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config
    sed -i 's/^#*Protocol.*/Protocol 2/' /etc/ssh/sshd_config
    sed -i 's/^#*X11Forwarding.*/X11Forwarding no/' /etc/ssh/sshd_config
    sed -i 's/^#*PermitEmptyPasswords.*/PermitEmptyPasswords no/' /etc/ssh/sshd_config
    sed -i 's/^#*MaxAuthTries.*/MaxAuthTries 4/' /etc/ssh/sshd_config
    sed -i 's/^#*ClientAliveInterval.*/ClientAliveInterval 300/' /etc/ssh/sshd_config
    sed -i 's/^#*ClientAliveCountMax.*/ClientAliveCountMax 0/' /etc/ssh/sshd_config
    
    # Add if not present
    grep -q "^LoginGraceTime" /etc/ssh/sshd_config || echo "LoginGraceTime 60" >> /etc/ssh/sshd_config
    
    systemctl restart sshd 2>/dev/null || service ssh restart
    ufw allow ssh
    printTime "SSH configured and secured per CIS standards."
else
    ufw deny ssh
    systemctl stop sshd 2>/dev/null
    systemctl disable sshd 2>/dev/null
    printTime "SSH disabled and firewall rule added."
fi

# Configure Firewall (UFW)
apt-get install -y ufw
ufw --force enable
ufw default deny incoming
ufw default allow outgoing
ufw logging on
printTime "Firewall enabled with default deny incoming."

# Samba
if [[ "$sambaYN" == "yes" ]]; then
    backup_file "/etc/samba/smb.conf"
    echo "Configure Samba in: /etc/samba/smb.conf"
    ufw allow samba
    printTime "Samba allowed through firewall. Manual configuration needed."
else
    apt-get purge -y samba samba-common samba-common-bin 2>/dev/null
    ufw deny samba
    printTime "Samba removed."
fi

# Apache Web Server
if [[ "$httpYN" == "yes" ]]; then
    backup_file "/etc/apache2/apache2.conf"
    ufw allow 80/tcp
    ufw allow 443/tcp
    
    # Basic Apache hardening
    if [[ -f /etc/apache2/apache2.conf ]]; then
        grep -q "ServerTokens" /etc/apache2/apache2.conf || echo "ServerTokens Prod" >> /etc/apache2/apache2.conf
        grep -q "ServerSignature" /etc/apache2/apache2.conf || echo "ServerSignature Off" >> /etc/apache2/apache2.conf
    fi
    printTime "Apache allowed through firewall and basic hardening applied."
else
    apt-get purge -y apache2* 2>/dev/null
    ufw deny 80/tcp
    ufw deny 443/tcp
    printTime "Apache removed and ports blocked."
fi

# MySQL
if [[ "$dbYN" == "yes" ]]; then
    backup_file "/etc/mysql/my.cnf"
    ufw allow 3306/tcp
    printTime "MySQL port allowed. Run mysql_secure_installation manually!"
else
    apt-get purge -y mysql-server mysql-client 2>/dev/null
    ufw deny 3306/tcp
    printTime "MySQL removed."
fi

# FTP
if [[ "$ftpYN" == "yes" ]]; then
    ufw allow ftp
    printTime "FTP allowed. Manual configuration strongly recommended."
else
    apt-get purge -y vsftpd 2>/dev/null
    ufw deny ftp
    printTime "FTP removed."
fi

# Password Policies (CIS compliant)
backup_file "/etc/login.defs"
sed -i 's/^PASS_MAX_DAYS.*/PASS_MAX_DAYS   90/' /etc/login.defs
sed -i 's/^PASS_MIN_DAYS.*/PASS_MIN_DAYS   7/' /etc/login.defs
sed -i 's/^PASS_MIN_LEN.*/PASS_MIN_LEN    14/' /etc/login.defs
sed -i 's/^PASS_WARN_AGE.*/PASS_WARN_AGE   14/' /etc/login.defs
printTime "Password aging policies set in /etc/login.defs."

# PAM password quality
apt-get install -y libpam-pwquality
backup_file "/etc/pam.d/common-password"
backup_file "/etc/security/pwquality.conf"

# Configure pwquality
cat > /etc/security/pwquality.conf <<EOF
minlen = 14
dcredit = -1
ucredit = -1
ocredit = -1
lcredit = -1
minclass = 4
maxrepeat = 3
EOF
printTime "PAM password quality requirements configured."

# Account lockout policy
backup_file "/etc/pam.d/common-auth"
if ! grep -q "pam_faillock" /etc/pam.d/common-auth; then
    sed -i '1i auth required pam_faillock.so preauth audit deny=5 unlock_time=1800' /etc/pam.d/common-auth
    printTime "Account lockout policy added (5 attempts, 30 min lockout)."
fi

# Remove dangerous/prohibited packages
printTime "Removing hacking tools and prohibited software..."
apt-get purge -y netcat* john* hydra* aircrack-ng ophcrack* nmap wireshark 2>/dev/null
printTime "Hacking tools removed."

# Remove media files if requested
if [[ "$mediaFilesYN" == "yes" ]]; then
    printTime "Searching and removing prohibited media files (this may take time)..."
    
    # Audio
    find /home -type f \( -iname "*.mp3" -o -iname "*.wav" -o -iname "*.flac" -o -iname "*.ogg" -o -iname "*.aac" \) -delete 2>/dev/null
    
    # Video  
    find /home -type f \( -iname "*.mp4" -o -iname "*.avi" -o -iname "*.mkv" -o -iname "*.mov" -o -iname "*.wmv" \) -delete 2>/dev/null
    
    printTime "Media files removed from /home directories."
fi

# Disable ctrl-alt-delete
systemctl mask ctrl-alt-del.target
printTime "Ctrl-Alt-Delete disabled."

# Enable AppArmor
apt-get install -y apparmor apparmor-utils
systemctl enable apparmor
systemctl start apparmor
printTime "AppArmor enabled."

# Secure cron
echo "root" > /etc/cron.allow
echo "root" > /etc/at.allow
chmod 600 /etc/cron.allow /etc/at.allow
printTime "Cron access restricted to root."

# Update system
printTime "Updating system packages..."
apt-get update
apt-get upgrade -y
apt-get dist-upgrade -y
apt-get autoremove -y
apt-get autoclean -y
printTime "System updated and cleaned."

# Enable automatic security updates
apt-get install -y unattended-upgrades
dpkg-reconfigure -plow unattended-upgrades
printTime "Automatic security updates enabled."

# Generate logs
printTime "Generating system logs..."
dpkg -l > "$HOME/Desktop/logs/installed_packages.log"
ss -tulpn > "$HOME/Desktop/logs/listening_ports.log"
systemctl list-units --type=service --state=running > "$HOME/Desktop/logs/running_services.log"
ufw status verbose > "$HOME/Desktop/logs/firewall_status.log"
printTime "System logs created in ~/Desktop/logs/"

# Final report
echo -e "\n${GREEN}========================================${NC}"
echo -e "${GREEN}Security Hardening Complete!${NC}"
echo -e "${GREEN}========================================${NC}"
printTime "Script completed successfully."
echo -e "\n${YELLOW}IMPORTANT: Review the following:${NC}"
echo "1. Check $LOGFILE for all changes"
echo "2. Review user accounts and permissions"
echo "3. If MySQL is installed, run: mysql_secure_installation"
echo "4. Review firewall rules: ufw status"
echo "5. Test SSH access before logging out"
echo "6. Check ~/Desktop/logs/ for system information"
echo -e "\n${RED}REBOOT RECOMMENDED${NC}"
